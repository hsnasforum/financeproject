prefix_rule(
  pattern = ["pnpm", ["test", "lint", "build", "verify", "e2e", "e2e:rc", "planning:v2:complete", "planning:v2:compat", "planning:v2:guard", "planning:v2:regress"]],
  decision = "allow",
  justification = "프로젝트 로컬 검증 명령 허용",
  match = [
    "pnpm test",
    "pnpm lint",
    "pnpm build",
    "pnpm verify",
    "pnpm e2e:rc",
    "pnpm planning:v2:complete"
  ]
)

prefix_rule(
  pattern = ["git", ["commit", "push", "merge", "rebase", "reset", "clean"]],
  decision = "prompt",
  justification = "Git 이력·작업공간 변경은 사용자 승인 범위를 다시 확인",
  match = [
    "git commit -m message",
    "git push origin main",
    "git merge feature",
    "git rebase main",
    "git reset --hard HEAD",
    "git clean -fd"
  ]
)

prefix_rule(
  pattern = ["gh", "pr", ["create", "merge"]],
  decision = "prompt",
  justification = "PR 생성·merge는 외부 GitHub 변경이므로 사용자 승인 범위를 다시 확인",
  match = [
    "gh pr create",
    "gh pr merge 123"
  ]
)
